PUBLIC_URL=https://templars.example.com
# Generate this with the init command; do not put your plain password here.
OWNER_PASSWORD_HASH=REPLACE_WITH_GENERATED_SCRYPT_HASH
CALLBACK_ORIGINS=https://chatgpt.com,https://claude.ai,https://claude.com
# Exactly one trusted proxy, and no direct external access to port 8787.
TRUST_PROXY=true
AUTO_REFRESH=true
PORT=8787
BIND_ADDRESS=0.0.0.0
